{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "schedule:weekly"
  ],
  "packageRules": [
    {
      "description": "Group all npm dependency updates into a single PR",
      "matchManagers": ["npm"],
      "groupName": "npm dependencies"
    },
    {
      "description": "Never auto-merge major dependency updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
